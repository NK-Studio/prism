    { "id": "thin-diag-size1", "note": "beading on a shallow diagonal", "canvas": { "width": 200, "height": 100 }, "size": 1, "points": [[20, 20], [180, 80]], "probe": { "column": 100 } },
    { "id": "thin-diag-size3", "canvas": { "width": 200, "height": 100 }, "size": 3, "points": [[20, 20], [180, 80]], "probe": { "column": 100 } },

    { "id": "pencil-diag-size1", "tool": "pencil", "canvas": { "width": 200, "height": 100 }, "size": 1, "points": [[20, 20], [180, 80]], "probe": { "column": 100 } },
    { "id": "pencil-size4", "note": "even pencil sizes snap to pixel corners", "tool": "pencil", "canvas": { "width": 200, "height": 100 }, "size": 4, "points": [[20, 50.3], [180, 50.3]], "probe": { "column": 100 } },
    { "id": "pencil-size5", "tool": "pencil", "canvas": { "width": 200, "height": 100 }, "size": 5, "points": [[20, 50.3], [180, 50.3]], "probe": { "column": 100 } }
  ]
