    { "id": "line-s100", "note": "dab placement: first dab, step, last point", "size": 30, "spacing": 100, "points": [[40, 60], [360, 60]], "probe": { "row": 60 } },
    { "id": "line-s150", "size": 30, "spacing": 150, "points": [[40, 60], [361, 60]], "probe": { "row": 60 } },

