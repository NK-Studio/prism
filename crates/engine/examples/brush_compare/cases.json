    { "id": "thin-size1-y50c", "note": "1 px line on a pixel centre", "canvas": { "width": 200, "height": 100 }, "size": 1, "points": [[20, 50.5], [180, 50.5]], "probe": { "column": 100 } },
    { "id": "thin-size2", "canvas": { "width": 200, "height": 100 }, "size": 2, "points": [[20, 50], [180, 50]], "probe": { "column": 100 } },
