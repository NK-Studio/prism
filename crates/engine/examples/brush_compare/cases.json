    { "id": "line-s25", "note": "baseline hard line", "size": 40, "points": [[40, 60], [360, 60]], "probe": { "column": 200 } },
    { "id": "line-flow10", "note": "flow build-up within one stroke", "size": 40, "flow": 10, "points": [[40, 60], [360, 60]], "probe": { "column": 200 } },
    { "id": "line-flow50", "size": 40, "flow": 50, "points": [[40, 60], [360, 60]], "probe": { "column": 200 } },
